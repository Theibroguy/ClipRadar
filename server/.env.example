PORT=3001
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/clipradar?retryWrites=true&w=majority

# Set to true to use local demo data instead of real API calls + DB
DEMO_MODE=true

# --- Platform API keys (leave blank to skip that platform) ---
YOUTUBE_API_KEY=
TWITTER_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# --- AI ---
GEMINI_API_KEY=

# --- Security ---
# The origin of the frontend for CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173
